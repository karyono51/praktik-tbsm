{
  "hosting": {
    "public": ".",
    "cleanUrls": true,
    "ignore": ["firebase.json", "appwrite.json", "README.md", "templates/**", "**/.*", "**/node_modules/**"],
    "headers": [
      { "source": "**/*.@(js|css|jpg)", "headers": [{ "key": "Cache-Control", "value": "public, max-age=3600" }] },
      { "source": "**", "headers": [{ "key": "X-Content-Type-Options", "value": "nosniff" }, { "key": "Referrer-Policy", "value": "strict-origin-when-cross-origin" }] }
    ]
  }
}
